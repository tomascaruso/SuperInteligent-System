{
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "bcryptjs": "^3.0.0",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite": "^7.3.7",
    "zod": "^4.0.0"
  },
  "description": "SuperInteligent Core + Business Operations Orchestrator (plantilla reutilizable)",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "jsdom": "^30.1.3",
    "pg-mem": "^3.0.14",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0"
  },
  "name": "superinteligent-system",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:client": "vite build --config client/vite.config.ts",
    "dev": "tsx watch src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "pretest": "npm run build:client",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck:client",
    "typecheck:client": "tsc --noEmit -p client/tsconfig.json",
    "seed": "tsx src/seed.ts",
    "ai-eval": "tsx scripts/ai-eval.ts"
  },
  "type": "module",
  "version": "0.1.0"
}
